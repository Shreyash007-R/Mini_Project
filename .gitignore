# ==========================================
# LibroHub - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow documentation template examples only
!.env.example
!.env.template

# Secret Keys, Certificates, and Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.token
credentials.json
client_secret*.json
secrets.py
instance/

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Testing & Cache
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------
# Database & Persistent Data
# ------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/library.db
library.db
*.dump
*.sql.gz

# ------------------------------------------
# Node.js & Frontend Artifacts
# ------------------------------------------
node_modules/
demo/node_modules/
demo/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Backups & Archives
# ------------------------------------------
backups/
*.bak
*.backup
*.orig

# ------------------------------------------
# Operating System & Editor Files
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# VS Code
.vscode/*
!.vscode/extensions.json

# JetBrains / IntelliJ / PyCharm
.idea/

# Editors swap / temporary files
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

